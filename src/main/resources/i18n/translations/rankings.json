        "ca_ES": "[minimsg]<dark_gray>  %1: K %2</dark_gray>"
      }
    },
    {
      "type": "text",
      "key": "minicat.rankings.book.leaving",
      "languages": {
        "en_US": "[minimsg]<black>Leaving an advanced match costs Elo, except for network failures.\n\n/elo · /top</black>",
        "ca_ES": "[minimsg]<black>Abandonar una partida avançada resta elo, tret d’errors de xarxa.\n\n/elo · /top</black>"
