    {
      "type": "text",
      "key": "minicat.rankings.book.intro",
      "languages": {
        "en_US": "[minimsg]<black><bold>Rating weight (K)</bold>\nHigher K means larger Elo changes.\n\nRelease: %1\nBeta: %2\nAlpha: %3\nPre-Alpha: %4\nKnown issues: %5\n\nMaps may override K.</black>",
        "ca_ES": "[minimsg]<black><bold>Pes de puntuació (K)</bold>\nMés K, més canvi d’elo.\n\nRelease: %1\nBeta: %2\nAlpha: %3\nPre-Alpha: %4\nErrors coneguts: %5\n\nEls mapes poden fixar K.</black>"
      }
    },
    {
      "type": "text",
      "key": "minicat.rankings.book.rules",
      "languages": {
        "en_US": "[minimsg]<black><bold>When matches count</bold>\n\n- More than 20 seconds\n- Balanced teams\n- Ranked scoring on\n- No player penalized</black>",
        "ca_ES": "[minimsg]<black><bold>Quan puntuen</bold>\n\n- Més de 20 segons\n- Equips equilibrats\n- Rànquing activat\n- Cap jugador penalitzat</black>"
      }
    },
    {
      "type": "text",
      "key": "minicat.rankings.book.games",
      "languages": {
        "en_US": "[minimsg]<black><bold>Games and weights</bold></black>",
        "ca_ES": "[minimsg]<black><bold>Jocs i pesos</bold></black>"
      }
    },
    {
      "type": "text",
      "key": "minicat.rankings.book.row",
      "languages": {
        "en_US": "[minimsg]<black>%1 <dark_green>K %2</dark_green></black>",
